---
layout: default
---
{%- comment -%}
  Local override of al_folio_core's about layout.
  The hero, PhD story, background and awards live in _pages/about.md (HTML sections);
  this layout adds news, selected publications and contact links underneath,
  using the same section styling (gd-* classes in _sass/_custom.scss).
{%- endcomment -%}
<div class="post gd-home">
  <article>
    {{ content }}

    {% if page.announcements and page.announcements.enabled %}
      <section class="gd-section" id="news">
        <div class="gd-section-head">
          <h2>News</h2>
          <a class="gd-more" href="{{ '/news/' | relative_url }}">All news &rarr;</a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="gd-section" id="selected-publications">
        <div class="gd-section-head">
          <h2>Selected publications</h2>
          <a class="gd-more" href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.social %}
      <section class="gd-section gd-contact" id="contact">
        <h2>Get in touch</h2>
        <p>
          Email is the best way to reach me:
          <a href="mailto:gduggal1729@gmail.com">gduggal1729@gmail.com</a>
          (or <a href="mailto:gduggal@vt.edu">gduggal@vt.edu</a>).
        </p>
        <div class="social">
          <div class="contact-icons">{% social_links %}</div>
        </div>
      </section>
    {% endif %}
  </article>
</div>
